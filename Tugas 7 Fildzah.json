      "parameters": {
        "jsCode": "const sekarang = DateTime.now().setZone('Asia/Jakarta').endOf('day');\nconst batas = sekarang.minus({ days: 7 }).startOf('day');\n\nconst data = $input.all().map(i => i.json).filter(r => {\n  if (!r['Tanggal']) return false;\n  const tgl = DateTime.fromFormat(String(r['Tanggal']).trim(), 'dd/MM/yyyy', { zone: 'Asia/Jakarta' });\n  return tgl.isValid && tgl >= batas && tgl <= sekarang;\n});\n\nconst total = data.reduce((s, r) => s + Number(r['Jumlah (IDR)'] || 0), 0);\n\nconst daftar = data.map((r, i) =>\n  `${i + 1}. ${r['Tanggal']} | ${r['Kategori']} | ${r['Deskripsi']} | ${r['Metode Pembayaran']} | Rp${r['Jumlah (IDR)']} | ${r['Penerima']}`\n).join('\\n');\n\nreturn [{ json: { jumlah: data.length, total, daftar } }];"
      },
